# Public configuration only. Copy into .env.production.local or hosting build variables.
# Replace every placeholder before running pwa:check or pwa:build.
VITE_APP_URL=https://SEU-ENDERECO-PUBLICADO
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA-CHAVE-PUBLICA
MEU_AGRO_EXPECTED_SUPABASE_HOST=SEU-PROJETO.supabase.co
# Set true only after configuring Google in Supabase.
VITE_AUTH_GOOGLE_ENABLED=false
